{
    "dataList": [
        {
            "id": 0,
            "content": "<style=\"den_CP6_2\">Ta đã hằng ao ước về bao điều",
            "vocalid": 0
        },
        {
            "id": 1,
            "content": "<style=\"den_CP6_2\">Tương lai, tốt đẹp, hạnh phúc, tươi sáng",
            "vocalid": 0
        },
        {
            "id": 2,
            "content": "<style=\"den_CP6_2\">Nhưng giờ đây trước cánh cổng thân quen",
            "vocalid": 0
        },
        {
            "id": 3,
            "content": "<style=\"den_CP6_2\">Hỡi tháng năm",
            "vocalid": 0
        },
        {
            "id": 4,
            "content": "<style=\"den_CP6_2\">Ta đã quyết định rồi",
            "vocalid": 0
        },
        {
            "id": 5,
            "content": "<style=\"den_CP6_2\">Nàng đã phải hứng chịu cơn giận tới nhường nào",
            "vocalid": 0
        },
        {
            "id": 6,
            "content": "<style=\"den_CP6_2\">Sự thô thiển vẻ khó xử sự cọc cằn",
            "vocalid": 0
        },
        {
            "id": 7,
            "content": "Chàng đã phải phớt lờ chính mình đến nhường nào",
            "vocalid": 1
        },
        {
            "id": 8,
            "content": "Sự thẳng thắn lòng chân thành phép lịch sự",
            "vocalid": 1
        },
        {
            "id": 9,
            "content": "<style=\"den_CP6_2\">Giờ đôi ta tại nơi định mệnh này",
            "vocalid": 0
        },
        {
            "id": 10,
            "content": "<style=\"den_CP6_2\">Vậy ta sẽ buông tay",
            "vocalid": 0
        },
        {
            "id": 11,
            "content": "Liệu anh sẽ buông tay?",
            "vocalid": 1
        },
        {
            "id": 12,
            "content": "<style=\"den_CP6_2\">Ôi",
            "vocalid": 0
        },
        {
            "id": 13,
            "content": "<style=\"den_CP6_2\">Trong vòng lặp trớ trêu",
            "vocalid": 0
        },
        {
            "id": 14,
            "content": "<style=\"den_CP6_2\">Ôm chặt vào cơn đau",
            "vocalid": 0
        },
        {
            "id": 15,
            "content": "<style=\"den_CP6_2\">Cái tôi trở thành chính tôi",
            "vocalid": 0
        },
        {
            "id": 16,
            "content": "<style=\"den_CP6_2\">Âm thầm trào dâng",
            "vocalid": 0
        },
        {
            "id": 17,
            "content": "<style=\"den_CP6_2\">Thêu dệt bởi chính tôi những kỷ niệm tàn phai",
            "vocalid": 0
        },
        {
            "id": 18,
            "content": "<style=\"den_CP6_2\">Mà người chẳng hề hay biết",
            "vocalid": 0
        },
        {
            "id": 19,
            "content": "<style=\"den_CP6_2\">Chỉ tôi hiểu",
            "vocalid": 0
        },
        {
            "id": 20,
            "content": "<style=\"den_CP6_2\">Vì tôi như nguồn cơn đớn đau",
            "vocalid": 0
        },
        {
            "id": 21,
            "content": "<style=\"den_CP6_2\">Là kẻ đem u sầu cho em",
            "vocalid": 0
        },
        {
            "id": 22,
            "content": "<style=\"den_CP6_2\">Người phá tan hy vọng trong em vỡ thành cát bụi",
            "vocalid": 0
        },
        {
            "id": 23,
            "content": "<style=\"den_CP6_2\">Vì tôi như nguồn cơn đớn đau",
            "vocalid": 0
        },
        {
            "id": 24,
            "content": "<style=\"den_CP6_2\">Người khiến em buông lời dối gian",
            "vocalid": 0
        },
        {
            "id": 25,
            "content": "<style=\"den_CP6_2\">Cũng không mong được gần bên em để em được sống bình yên",
            "vocalid": 0
        },
        {
