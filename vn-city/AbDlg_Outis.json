      "id": 1,
      "personalityid": 11101,
      "voiceFile": 0,
      "teller": "Outis",
      "dialog": "Chiến thắng đã nằm chắc trong tay ta rồi. Tất cả đều nhờ vào chiến thuật tài tình của ngài.",
      "usage": "(800101, VERY_HIGH), (800102, VERY_HIGH), (800104, VERY_HIGH), (800105, VERY_HIGH)"
    },
    {
      "id": 2,
      "personalityid": 11101,
      "voiceFile": 0,
      "teller": "Outis",
      "dialog": "Lợi thế đang thuộc về chúng ta. Xin ngài hãy để tôi xử lý nó.",
      "usage": "(800101, HIGH), (800102, HIGH), (800104, HIGH), (800105, HIGH) "
    },
    {
      "id": 3,
      "personalityid": 11101,
      "voiceFile": 0,
      "teller": "Outis",
      "dialog": "Xin ngài hãy để tôi xử lý, tôi chắc chắn sẽ không làm ngài thất vọng.",
      "usage": "(800101, NORMAL), (800102, NORMAL), (800104, NORMAL), (800105, NORMAL)"
    },
    {
      "id": 4,
      "personalityid": 11101,
      "voiceFile": 0,
      "teller": "Outis",
      "dialog": "Tuy kế hoạch ngài đề ra rất hoàn hảo, nhưng tôi không chắc mình có khả năng để đáp ứng kỳ vọng ấy.",
      "usage": "(800101, LOW), (800102, LOW), (800104, LOW), (800105, LOW)"
    },
    {
      "id": 5,
      "personalityid": 11101,
      "voiceFile": 0,
      "teller": "Outis",
      "dialog": "Tên nào đề ra cái thứ dở hơ- À, tôi chỉ đang đùa thôi mà, ngài thấy như nào?",
      "usage": "(800101, VERY_LOW), (800102, VERY_LOW), (800104, VERY_LOW), (800105, VERY_LOW) "
    },
    {
      "id": 6,
      "personalityid": 11101,
      "voiceFile": 0,
      "teller": "Outis",
      "dialog": "Chúng ta có được vinh quang này đều là nhờ vào chiến lược xuất sắc của ngài.",
      "usage": "(800101, SUCCESS), (800102, SUCCESS), (800104, SUCCESS), (800105, SUCCESS)"
    },
