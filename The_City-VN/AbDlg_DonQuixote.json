      "dialog": "Vãi cả lờ thâttj chứ",
      "usage": "(800101, VERY_HIGH), (800102, VERY_HIGH), (800104, VERY_HIGH), (800105, VERY_HIGH)"
    },
    {
      "id": 37,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "Ngài đừng sợ. Việc này dĩ nhiên nằm trong khả năng của ta!",
      "usage": "(800101, HIGH), (800102, HIGH), (800104, HIGH), (800105, HIGH) "
    },
    {
      "id": 38,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "Ta đây làm được! Yếu tố nỗ lực rất cần thiết để chiến binh có thể tiến bước!",
      "usage": "(800101, NORMAL), (800102, NORMAL), (800104, NORMAL), (800105, NORMAL)"
    },
    {
      "id": 39,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "Ta sẽ dốc toàn tâm toàn lực! Anh hùng thực sự là người dám thực hiện điều bất khả thi!",
      "usage": "(800101, LOW), (800102, LOW), (800104, LOW), (800105, LOW)"
    },
    {
      "id": 40,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "…Tiến lên phía trước dẫu biết hiểm nguy đang chực chờ - thực là phong thái của một anh hùng!",
      "usage": "(800101, VERY_LOW), (800102, VERY_LOW), (800104, VERY_LOW), (800105, VERY_LOW) "
    },
    {
      "id": 41,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "Ta đây sẽ không đắm mình trong vinh quang! Sau cùng, ta tin rằng lịch sử sẽ khắc ghi hành động này!",
      "usage": "(800101, SUCCESS), (800102, SUCCESS), (800104, SUCCESS), (800105, SUCCESS)"
    },
    {
      "id": 42,
      "personalityid": 10301,
      "voicefile": 0,
      "teller": "Don Quixote",
      "dialog": "Một anh hùng đích thực là người có khả năng vượt qua nghịch cảnh. Chúng ta sẽ thử lại vào lần tới!",
      "usage": "(800101, FAILURE), (800102, FAILURE), (800104, FAILURE), (800105, FAILURE)"
