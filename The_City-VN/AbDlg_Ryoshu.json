      "teller": "Ryōshū",
      "dialog": "Quá dễ, ta còn chẳng cần phải bận tâm.",
      "usage": "(800101, VERY_HIGH), (800102, VERY_HIGH), (800104, VERY_HIGH), (800105, VERY_HIGH)"
    },
    {
      "id": 2,
      "personalityid": 10401,
      "voiceFile": 0,
      "teller": "Ryōshū",
      "dialog": "Có nhất thiết cứ phải là ta trong khi còn lũ kia còn đứng đờ ra đấy?",
      "usage": "(800101, HIGH), (800102, HIGH), (800104, HIGH), (800105, HIGH) "
    },
    {
      "id": 3,
      "personalityid": 10401,
      "voiceFile": 0,
      "teller": "Ryōshū",
      "dialog": "Trông cũng xử lý được.",
