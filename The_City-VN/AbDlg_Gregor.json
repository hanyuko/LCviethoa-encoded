{
  "dataList": [
    {
      "id": 1,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Ồ, việc này trông cũng chẳng khó nhọc gì mấy nhỉ?",
      "usage": "(800101, VERY_HIGH), (800102, VERY_HIGH), (800104, VERY_HIGH), (800105, VERY_HIGH)"
    },
    {
      "id": 2,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Có vẻ sẽ hơi phiền phức, nhưng mà… chắc vẫn làm được.",
      "usage": "(800101, HIGH), (800102, HIGH), (800104, HIGH), (800105, HIGH) "
    },
    {
      "id": 3,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Chà… Tôi cũng chả muốn lắm đâu, nhưng mà sếp bảo thì phải nghe mà.",
      "usage": "(800101, NORMAL), (800102, NORMAL), (800104, NORMAL), (800105, NORMAL)"
    },
    {
      "id": 4,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Đó có phải là mệnh lệnh không ấy? Nếu ngài chỉ đang hỏi thôi, thì tôi nghĩ việc này nên để người khác.",
      "usage": "(800101, LOW), (800102, LOW), (800104, LOW), (800105, LOW)"
    },
    {
      "id": 5,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "…Ngài ra dáng thể loại sếp sau này bị cấp dưới đâm sau lưng lắm đấy.",
      "usage": "(800101, VERY_LOW), (800102, VERY_LOW), (800104, VERY_LOW), (800105, VERY_LOW) "
    },
    {
      "id": 6,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Hừm, ăn may thôi.",
      "usage": "(800101, SUCCESS), (800102, SUCCESS), (800104, SUCCESS), (800105, SUCCESS)"
    },
    {
      "id": 7,
      "personalityid": 11201,
      "voiceFile": 0,
      "teller": "Gregor",
      "dialog": "Khốn thật đấy. Muốn làm điếu không?",
      "usage": "(800101, FAILURE), (800102, FAILURE), (800104, FAILURE), (800105, FAILURE)"
    },
